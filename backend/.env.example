# Server Configuration
PORT=3000
NODE_ENV=development
REQUEST_TIMEOUT=30000

# MongoDB Atlas (FREE - 512MB)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/spotify_clone?retryWrites=true&w=majority

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=30d

# Firebase Auth (FREE) - optional, only for Google Sign-In
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (FREE - 25GB/month) - optional, only for avatar/playlist cover uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Cloud (FREE - 30MB) - optional, caching
REDIS_URL=

# Mailgun (FREE - 100 emails/day) - optional, emails fall back to dev logging
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# Music source: keyless YouTube via yt-dlp (no API key required)
YT_DLP_PATH=yt-dlp
# YouTube Music Global Top 100 playlist used for trending
TRENDING_PLAYLIST_URL=https://www.youtube.com/playlist?list=PL4fGSI1pDJn5kI81J1cQWv5U5y_WbJD9g
AUDIO_CACHE_TTL_HOURS=12
